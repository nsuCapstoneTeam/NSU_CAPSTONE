POSTGRES_USER=capstone
POSTGRES_PASSWORD=
POSTGRES_DB=capstone_db
POSTGRES_PORT=5432

REDIS_PORT=6379
# Compose Redis dataset limit; eviction must remain disabled.
REDIS_MAXMEMORY=256mb

# Generate a long random value locally. Never commit the real secret.
SIGNUP_VERIFICATION_HMAC_SECRET=
# Default required IDs: service, privacy.
# Enable DEMO explicitly with SPRING_PROFILES_ACTIVE=demo; then all four IDs are required.
# Comma-separated <term-id>:<version> entries managed by deployment configuration.
# Default example only: service:v1,privacy:v1
# DEMO example only: service:v1,privacy:v1,demo-notice:v1,overseas-transfer:v1
SIGNUP_REQUIRED_TERMS=

# Base64-encoded secret with at least 256 bits. Never commit the real secret.
JWT_ACCESS_TOKEN_SECRET=
# Optional override. The default access token TTL is 30 minutes.
JWT_ACCESS_TOKEN_TTL=PT30M

# OAuth is disabled by default. Enable only after all provider settings are configured.
OAUTH_ENABLED=false
OAUTH_FRONTEND_REDIRECT_URI=
# Set false only for local HTTP development. Production keeps the default (true).
OAUTH_BINDING_COOKIE_SECURE=true
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_OAUTH_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ISSUER_URI=
KAKAO_AUTHORIZATION_URI=
KAKAO_TOKEN_URI=
KAKAO_JWK_SET_URI=
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v1/oidc/userinfo
KAKAO_CLIENT_AUTHENTICATION_METHOD=
NAVER_OAUTH_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_ISSUER_URI=
NAVER_AUTHORIZATION_URI=
NAVER_TOKEN_URI=
NAVER_JWK_SET_URI=
NAVER_USER_INFO_URI=
NAVER_CLIENT_AUTHENTICATION_METHOD=

# External verification delivery providers are disabled by default.
SOLAPI_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM_NUMBER=

RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AudD music recognition (released-recording check) is disabled by default.
AUDD_ENABLED=false
AUDD_API_TOKEN=

# Public authentication request limits (Asia/Seoul calendar hour).
SIGNUP_SESSION_HOURLY_LIMIT=30
OAUTH_HOURLY_LIMIT=30
LOGIN_HOURLY_LIMIT=30
LOGIN_FAILURES_HOURLY_LIMIT=10

# Optional locally. Use a #dev Incoming Webhook from secret configuration; never commit the real URL.
VERIFICATION_SLACK_WEBHOOK_URL=
VERIFICATION_CONNECT_TIMEOUT=3s
VERIFICATION_READ_TIMEOUT=10s
VERIFICATION_PENDING_RECOVERY=15s
VERIFICATION_ALERT_TIMEOUT=3s
